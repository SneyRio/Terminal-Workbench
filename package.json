{
  "name": "wbspace",
  "version": "1.4.1",
  "private": true,
  "description": "Local workspaces for agent CLIs",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node scripts/smoke.mjs",
    "rebuild:native": "electron-rebuild -f -w node-pty && node scripts/prepare-pty.mjs",
    "postinstall": "node node_modules/electron/install.js && npm run rebuild:native",
    "package:mac": "npm run build:icon && npm run build && node scripts/package.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "release:mac": "npm run build && node scripts/package.mjs && node scripts/release-mac.mjs",
    "build:icon:win": "node scripts/build-icon-win.mjs",
    "package:win": "npm run build:icon:win && npm run build && node scripts/package-win.mjs",
    "release:win": "npm run package:win && node scripts/release-windows.mjs",
    "test:windows": "node scripts/windows-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@phosphor-icons/react": "^2.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.3.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.0",
    "node-pty": "^1.1.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^45.2.2",
    "electron-builder": "26.18.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
